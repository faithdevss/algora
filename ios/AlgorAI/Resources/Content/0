[steps[1]] {"number": 2, "title": "Replace the Head", "body": "Swap the final classifier for one shaped to your label set, randomly initialized."}
[steps[2]] {"number": 3, "title": "Freeze and Train the Head", "body": "With the backbone frozen only the new layer learns — fast, and safe on tiny datasets."}
[steps[3]] {"number": 4, "title": "Unfreeze and Fine-Tune", "body": "Release the upper layers and continue at a much smaller learning rate."}
[steps[4]] {"number": 5, "title": "Use Discriminative Rates", "body": "Deeper layers hold the most general features, so give them the smallest learning rates."}
