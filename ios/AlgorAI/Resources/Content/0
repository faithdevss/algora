[steps[1]] {"number": 2, "title": "Warp Each to a Fixed Size", "body": "227×227, because the CNN behind it takes nothing else."}
[steps[2]] {"number": 3, "title": "Run the CNN 2,000 Times", "body": "One forward pass per region. This is the 47 seconds."}
[steps[3]] {"number": 4, "title": "Classify With Per-Class SVMs", "body": "Trained separately, on features cached to disk."}
[steps[4]] {"number": 5, "title": "Refine the Box", "body": "A per-class linear regressor on the same features."}
[steps[5]] {"number": 6, "title": "Suppress and Score", "body": "NMS at IoU 0.5, then average precision over what survives."}
