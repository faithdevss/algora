[formulas[1]] {"label": "Non-maximum suppression", "formula": "keep argmax score; drop all IoU > τ; repeat", "note": "τ = 0.5 conventionally."}
[formulas[2]] {"label": "Precision / recall", "formula": "P = TP/(TP+FP), R = TP/(TP+FN)", "note": "A duplicate detection is a false positive, not a duplicate."}
