<?xml version="1.0" encoding="utf-8"?>
<!--
  Systa's app icon, for the "More from the developer" cross-promo tile. Mirrors Systa's own
  ic_launcher_background/foreground vectors (teal "Shade" gradient, white "»-fork" glyph) so the promo
  shows the real listing icon rather than a stand-in glyph. The glyph is scaled up from the launcher
  safe zone, since this renders in a ~40dp tile rather than behind an adaptive-icon mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Teal gradient base. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38.22"
                android:startY="10.64"
                android:endX="69.78"
                android:endY="97.36">
                <item android:offset="0" android:color="#40C8E0" />
                <item android:offset="0.55" android:color="#00829A" />
                <item android:offset="1" android:color="#005E70" />
            </gradient>
        </aapt:attr>
    </path>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.5"
        android:scaleY="1.5">
        <path
            android:pathData="M39.06,46.8 L44.46,54 L39.06,61.2 M46.26,46.8 L51.66,54 L46.26,61.2 M51.66,54 L58.86,54 M58.86,54 L64.26,45 M58.86,54 L64.26,63 M63.18,43.2 a2.88,2.88 0 1,0 5.76,0 a2.88,2.88 0 1,0 -5.76,0 M63.18,64.8 a2.88,2.88 0 1,0 5.76,0 a2.88,2.88 0 1,0 -5.76,0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
