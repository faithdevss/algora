<?xml version="1.0" encoding="utf-8"?>
<!--
  Node graph mark from docs/design/Algora Icon.html.
  Design tile is 300x300 at (450,250); coordinates below are tile-local.
  The group scales the mark into the 66dp adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="300"
    android:viewportHeight="300">
    <group
        android:pivotX="150"
        android:pivotY="150"
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateY="-8.7">

        <!-- edges -->
        <path
            android:pathData="M150,95 L78,240"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.35"
            android:strokeWidth="21"
            android:strokeLineCap="round" />
        <path
            android:pathData="M150,95 L222,240"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.35"
            android:strokeWidth="21"
            android:strokeLineCap="round" />
        <path
            android:pathData="M105,185 L195,185"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.35"
            android:strokeWidth="21"
            android:strokeLineCap="round" />

        <!-- nodes -->
        <path
            android:pathData="M114,95 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0z"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M48,240 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0z"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M192,240 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0z"
            android:fillColor="#FFFFFF" />

        <!-- root node core -->
        <path
            android:pathData="M136,95 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0z"
            android:fillColor="#FF5B21B6" />
    </group>
</vector>
